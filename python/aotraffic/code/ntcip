
from abc import ABC, abstractmethod

class NtcipTrafficSignalController(ABC):
    def __init__(self, address: str):
        self.address = address  # IP address or other identifying information for the controller

    @abstractmethod
    def send_command(self, command: str) -> str:
        """Send a command to the traffic signal controller and return the response."""
        pass

    @abstractmethod
    def get_status(self) -> dict:
        """Get the current status of the traffic signal controller."""
        pass

    @abstractmethod
    def configure_timing(self, timing_data: dict) -> None:
        """Configure the timing parameters for the traffic signal controller."""
        pass

    @abstractmethod
    def reset_controller(self) -> None:
        """Reset the traffic signal controller to a known state."""
        pass

# Example usage of the NtcipTrafficSignalController class
class SimulatedNtcipTrafficSignalController(NtcipTrafficSignalController):
    def __init__(self, address: str):
        super().__init__(address)
        self.status = {
            "phase": "Green",
            "duration": 60,
            "next_phase": "Yellow",
            "detectors": [
                {"id": "D1", "status": "occupied"},
                {"id": "D2", "status": "vacant"},
                {"id": "D3", "status": "occupied"}
            ]
        }

    def send_command(self, command: str) -> str:
        print(f"Sending command to {self.address}: {command}")
        return f"Command '{command}' processed successfully."

    def get_status(self) -> dict:
        return self.status

    def configure_timing(self, timing_data: dict) -> None:
        self.status.update(timing_data)
        print(f"Timing configured for {self.address}: {self.status}")

    def reset_controller(self) -> None:
        self.status = {
            "phase": "Red",
            "duration": 0,
            "next_phase": "Green",
            "detectors": []
        }
        print(f"Controller {self.address} reset to initial state.")

# Example usage
controller = SimulatedNtcipTrafficSignalController("192.168.1.1")
print(controller.get_status())

